# === Messaging API Channel（Rich Menu、Webhook、推播）===
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# === LINE Login Channel（LIFF 網頁）===
LIFF_ID=
LIFF_BASE_URL=https://liff.line.me/YOUR_LIFF_ID

# Instagram（Rich Menu 第二格）
IG_URL=https://www.instagram.com/your_account/

# === Server ===
PORT=3000
# 正式環境：Railway 公開網域，例如 https://wendy-studio.up.railway.app
BASE_URL=https://your-production-domain

# 管理員 LINE User ID（新 OA 加好友後取得，見 docs/LINE_ACCOUNT_MIGRATION.md）
ADMIN_LINE_USER_ID=

# === 正式環境安全 ===
# 正式環境務必設 false
OTP_DEV_MODE=false

# === Database ===
# 本機：./data/wendy.db
# Railway（掛 Volume 後）：/app/server/data/wendy.db
DATABASE_PATH=./data/wendy.db

# === 購課預設 ===
DEFAULT_SESSIONS_PER_PURCHASE=10
DEFAULT_PURCHASE_AMOUNT=3000

# === Google Sheets（選填）===
GOOGLE_SHEETS_SPREADSHEET_ID=
# 本機：./credentials/your-service-account.json
# Railway：/app/server/credentials/your-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/your-service-account.json
GOOGLE_SHEETS_BOOKINGS_TAB=預約
GOOGLE_SHEETS_PURCHASES_TAB=匯款訂單
GOOGLE_SHEETS_URL=
